DATABASE_URL=sqlite+aiosqlite:///./dev.db
# For production Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname

# Observability Configuration
OTEL_ENABLED=true
OTEL_TRACING_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_SLOW_QUERY_THRESHOLD_MS=100
OTEL_LOG_LEVEL=INFO
OTEL_LOG_FORMAT=console
# OTEL_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# MCP Streamable HTTP
MCP_ENABLED=true
# Comma-separated Host values accepted by MCP transport security
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,test

# Optional classification provider
DEMO_MODE=false
CLASSIFIER_PROVIDER=local
# JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
